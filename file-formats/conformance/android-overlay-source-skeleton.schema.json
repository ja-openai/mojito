{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/box/mojito/file-formats/conformance/android-overlay-source-skeleton.schema.json",
  "title": "Mojito source-preserving Android resource overlay",
  "type": "object",
  "required": ["schemaVersion", "sourceFormat", "sources"],
  "additionalProperties": false,
  "dependentRequired": {
    "androidSelectedProducts": ["androidRuntimeSlotOwners"],
    "androidRuntimeSlotOwners": ["androidSelectedProducts"]
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceFormat": { "const": "android" },
    "androidSelectedProducts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "androidRuntimeSlotOwners": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "androidApplicationPackage": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
    },
    "androidMacroOwners": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["sourceSet", "resourcePath"],
        "additionalProperties": false,
        "properties": {
          "sourceSet": {
            "enum": ["library", "main", "product_flavor", "build_type", "build_variant"]
          },
          "resourcePath": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sourceSet", "resourcePath", "skeleton"],
        "additionalProperties": false,
        "properties": {
          "sourceSet": {
            "enum": ["library", "main", "product_flavor", "build_type", "build_variant"]
          },
          "resourcePath": { "type": "string", "minLength": 1 },
          "skeleton": { "$ref": "source-skeleton.schema.json" }
        }
      }
    }
  }
}
