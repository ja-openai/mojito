<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
  <dict>
    <!-- Preserve native metadata for the retained plural entry. -->
    <key>retained</key>
    <dict>
      <key>NSStringLocalizedFormatKey</key>
      <string>%#@signals@ anchored</string>
      <key>signals</key>
      <dict>
        <key>NSStringFormatSpecTypeKey</key>
        <string>NSStringPluralRuleType</string>
        <key>NSStringFormatValueTypeKey</key>
        <string>d</string>
        <key>one</key><string>%d сигнал у причала</string>
        <key>few</key><string>%d сигналов у причала</string>
        <key>many</key><string>%d сигналов у причала</string>
        <key>other</key><string>%d сигналов у причала</string>
      </dict>
    </dict>
    <!-- Keep unrelated source comments around removed messages. -->
  </dict>
</plist>
