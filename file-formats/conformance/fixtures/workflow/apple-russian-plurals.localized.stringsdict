<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>lanterns.remaining</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key><string>%#@lanterns@ remaining</string>
    <key>lanterns</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key><string>d</string>
      <key>one</key><string>%d фонарь</string>
      <key>few</key><string>%d фонарей</string>
      <key>many</key><string>%d фонарей</string>
      <key>other</key><string>%d фонарей</string>
    </dict>
  </dict>
</dict></plist>
