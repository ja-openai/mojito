{
  "sourceLanguage": "he",
  "version": "1.0",
  "strings": {
    "harbor.target.substitution.scalar🧭": {
      "comment": "Russian target definitions own plural categories independently",
      "localizations": {
        "iw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guide %3$@: %#@lanes@ beside %2$#@lights@"
          },
          "substitutions": {
            "lanes": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "%1$lld open lane"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%1$lld open lanes"
                    }
                  }
                }
              }
            },
            "lights": {
              "argNum": 2,
              "formatSpecifier": "d",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "%2$d dock light"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%2$d dock lights"
                    }
                  }
                }
              }
            }
          }
        },
        "ru": {
          "stringUnit": {
            "state": "future_review",
            "value": "Маршрут %3$@: %#@lanes@ рядом %2$#@lights@"
          },
          "substitutions": {
            "lanes": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "%1$lld %4$n полоса"
                    }
                  },
                  "few": {
                    "stringUnit": {
                      "state": "new",
                      "value": "%1$lld %4$n полосы"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "future_review",
                      "value": "%1$lld %4$n полос"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%1$lld %4$n полосы"
                    }
                  }
                }
              }
            },
            "lights": {
              "argNum": 2,
              "formatSpecifier": "d",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "%2$d %4$n огонь"
                    }
                  },
                  "few": {
                    "stringUnit": {
                      "state": "new",
                      "value": "%2$d %4$n огня"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "future_review",
                      "value": "%2$d %4$n огней"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%2$d %4$n огня"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
