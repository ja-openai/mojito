    "harbor.target.substitution.scalar🧭": {
      "comment": "Russian target definitions own plural categories independently",
      "localizations": {
        "zh-cmn-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guide %3$@: %#@lanes@ beside %2$#@lights@"
          },
          "substitutions": {
            "lanes": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "%1$lld open lane"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%1$lld open lanes"
                    }
                  }
                }
              }
            },
            "lights": {
              "argNum": 2,
              "formatSpecifier": "d",
              "variations": {
