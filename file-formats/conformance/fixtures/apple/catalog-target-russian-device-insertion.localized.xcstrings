{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "harbor.target.device.scalar🧭": {
      "comment": "Target languages own device-specific scalar text independently",
      "localizations": {
        "en": {
          "variations": {
            "device": {
              "iphone": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "Touch %1$@ %2$n beacon"
                }
              },
              "mac": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Click %1$@ %2$n beacon"
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "device": {
              "iphone": {
                "stringUnit": {
                  "state": "needs_review",
                  "value": "На iPhone %1$@ %2$n у маяка"
                }
              },
              "mac": {
                "stringUnit": {
                  "state": "future_review",
                  "value": "На Mac %1$@ %2$n у маяка"
                }
              }
            }
          }
        }
      }
    },
