  "source": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<resources xmlns:code=\"urn:oasis:names:tc:xliff:document:1.2\">\n  <!-- Hash spellings are original neutral cases, not platform examples. -->\n  <string name=\"scalar_hash\">Dock #7</string>\n  <string name=\"escaped_hash\">Dock \\#8</string>\n  <string name=\"entity_hash\">Dock &#35;9</string>\n  <string name=\"unicode_hash\">Dock \\u002310</string>\n  <string name=\"protected_conventional\"><code:g id=\"arg0\">%1$s</code:g> #harbor</string>\n  <string name=\"mixed_conventional\"><code:g id=\"arg0\">%1$s</code:g> / %1$s / <code:g id=\"arg0\" example=\"\">%1$s</code:g> #signal</string>\n  <string name=\"styled_conventional\"><b lane=\"#signal\"><code:g id=\"arg0\">%1$s</code:g></b> / %1$s</string>\n\n  <!-- Generic TYPE_ANY recognizes an unescaped leading color as a primitive. -->\n  <item type=\"string\" name=\"primitive_color\">#abc</item>\n  <item type=\"string\" name=\"escaped_color\">\\#abc</item>\n  <item type=\"string\" name=\"unicode_color\">\\u0023abc</item>\n  <item type=\"string\" name=\"quoted_color\">\"#abc\"</item>\n  <item type=\"string\" name=\"strict_color\" format=\"string\">#abc</item>\n\n  <!-- Untyped array colors remain protected slots; escaped colors stay editable. -->\n  <array name=\"mixed_hashes\">\n    <item>#abc</item>\n    <item>\\#abc</item>\n    <item>\"#abc\"</item>\n    <item>Dock ##4</item>\n    <item>Dock &#35;5</item>\n  </array>\n\n  <string-array name=\"hash_routes\">\n    <item>#lane north</item>\n    <item>Dock \\#lane south</item>\n    <item>Dock &#35;lane east</item>\n  </string-array>\n\n  <string-array name=\"conventional_routes\">\n    <item><code:g id=\"arg0\">%1$s</code:g> #north</item>\n    <item>%1$s / <code:g id=\"arg0\">%1$s</code:g> ##south</item>\n  </string-array>\n\n  <plurals name=\"raw_signals\">\n    <item quantity=\"one\">%1$d route #north</item>\n    <item quantity=\"other\">%1$d routes ##north</item>\n  </plurals>\n  <plurals name=\"escaped_signals\">\n    <item quantity=\"one\">%1$d route \\#west</item>\n    <item quantity=\"other\">%1$d routes &#35;west</item>\n  </plurals>\n  <plurals name=\"styled_signals\">\n    <item quantity=\"one\">%1$d <b lane=\"&#35;inner\">#blue</b> route</item>\n    <item quantity=\"other\">%1$d <i lane=\"hash#inner\">##blue</i> routes</item>\n  </plurals>\n  <plurals name=\"protected_signals\">\n    <item quantity=\"one\"><code:g id=\"count\" example=\"#1\">%1$d</code:g> protected #lane</item>\n    <item quantity=\"other\"><code:g id=\"count\" example=\"#2\">%1$d</code:g> protected ##lanes</item>\n  </plurals>\n  <plurals name=\"optional_examples\">\n    <item quantity=\"one\"><code:g id=\"count\">%1$d</code:g> omitted #north</item>\n    <item quantity=\"other\"><code:g id=\"count\" example=\"#many\">%1$d</code:g> supplied ##north</item>\n  </plurals>\n  <plurals name=\"empty_examples\">\n    <item quantity=\"one\"><code:g id=\"count\" example=\"\">%1$d</code:g> empty #west</item>\n    <item quantity=\"other\"><code:g id=\"count\">%1$d</code:g> absent ##west</item>\n  </plurals>\n  <plurals name=\"repeated_examples\">\n    <item quantity=\"one\"><code:g id=\"count\" example=\"#lead\">%1$d</code:g>/<code:g id=\"count\" example=\"#tail\">%1$d</code:g> repeated #east</item>\n    <item quantity=\"other\"><code:g id=\"count\" example=\"#tail\">%1$d</code:g>/<code:g id=\"count\" example=\"#lead\">%1$d</code:g> repeated ##east</item>\n  </plurals>\n  <plurals name=\"conventional_signals\">\n    <item quantity=\"one\"><code:g id=\"arg0\">%1$d</code:g> #bridge</item>\n    <item quantity=\"other\">%1$d / <code:g id=\"arg0\">%1$d</code:g> ##bridges</item>\n  </plurals>\n  <plurals name=\"conventional_examples\">\n    <item quantity=\"one\"><code:g id=\"arg0\">%1$d</code:g>/<code:g id=\"arg0\" example=\"\">%1$d</code:g> #east</item>\n    <item quantity=\"other\"><code:g id=\"arg0\" example=\"\">%1$d</code:g>/<code:g id=\"arg0\">%1$d</code:g> ##east</item>\n  </plurals>\n\n  <plurals name=\"product_signals\" product=\"default\">\n    <item quantity=\"one\">%1$d default #signal</item>\n    <item quantity=\"other\">%1$d default ##signals</item>\n  </plurals>\n  <plurals name=\"product_signals\" product=\"tablet\">\n    <item quantity=\"one\">%1$d tablet #signal</item>\n    <item quantity=\"other\">%1$d tablet ##signals</item>\n  </plurals>\n\n  <string translatable=\"false\" name=\"protected_private\">Keep #protected</string>\n</resources>\n",
