<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:code="urn:oasis:names:tc:xliff:document:1.2">
  <!-- Hash spellings are original neutral cases, not platform examples. -->
  <string name="scalar_hash">Dock #7</string>
  <string name="escaped_hash">Dock \#8</string>
  <string name="entity_hash">Dock &#35;9</string>
  <string name="unicode_hash">Dock \u002310</string>
  <string name="protected_conventional"><code:g id="arg0">%1$s</code:g> #harbor</string>
  <string name="mixed_conventional"><code:g id="arg0">%1$s</code:g> / %1$s / <code:g id="arg0" example="">%1$s</code:g> #signal</string>
  <string name="styled_conventional"><b lane="#signal"><code:g id="arg0">%1$s</code:g></b> / %1$s</string>

  <!-- Generic TYPE_ANY recognizes an unescaped leading color as a primitive. -->
  <item type="string" name="primitive_color">#abc</item>
  <item type="string" name="escaped_color">\#abc</item>
  <item type="string" name="unicode_color">\u0023abc</item>
  <item type="string" name="quoted_color">"#abc"</item>
  <item type="string" name="strict_color" format="string">#abc</item>

  <!-- Untyped array colors remain protected slots; escaped colors stay editable. -->
  <array name="mixed_hashes">
    <item>#abc</item>
    <item>\#abc</item>
    <item>"#abc"</item>
    <item>Dock ##4</item>
    <item>Dock &#35;5</item>
  </array>

  <string-array name="hash_routes">
    <item>#lane north</item>
    <item>Dock \#lane south</item>
    <item>Dock &#35;lane east</item>
  </string-array>

  <string-array name="conventional_routes">
    <item><code:g id="arg0">%1$s</code:g> #north</item>
    <item>%1$s / <code:g id="arg0">%1$s</code:g> ##south</item>
  </string-array>

  <plurals name="raw_signals">
    <item quantity="one">%1$d route #north</item>
    <item quantity="other">%1$d routes ##north</item>
  </plurals>
  <plurals name="escaped_signals">
    <item quantity="one">%1$d route \#west</item>
    <item quantity="other">%1$d routes &#35;west</item>
  </plurals>
  <plurals name="styled_signals">
    <item quantity="one">%1$d <b lane="&#35;inner">#blue</b> route</item>
    <item quantity="other">%1$d <i lane="hash#inner">##blue</i> routes</item>
  </plurals>
  <plurals name="protected_signals">
    <item quantity="one"><code:g id="count" example="#1">%1$d</code:g> protected #lane</item>
    <item quantity="other"><code:g id="count" example="#2">%1$d</code:g> protected ##lanes</item>
  </plurals>
  <plurals name="optional_examples">
    <item quantity="one"><code:g id="count">%1$d</code:g> omitted #north</item>
    <item quantity="other"><code:g id="count" example="#many">%1$d</code:g> supplied ##north</item>
  </plurals>
  <plurals name="empty_examples">
    <item quantity="one"><code:g id="count" example="">%1$d</code:g> empty #west</item>
    <item quantity="other"><code:g id="count">%1$d</code:g> absent ##west</item>
  </plurals>
  <plurals name="repeated_examples">
    <item quantity="one"><code:g id="count" example="#lead">%1$d</code:g>/<code:g id="count" example="#tail">%1$d</code:g> repeated #east</item>
    <item quantity="other"><code:g id="count" example="#tail">%1$d</code:g>/<code:g id="count" example="#lead">%1$d</code:g> repeated ##east</item>
  </plurals>
  <plurals name="conventional_signals">
    <item quantity="one"><code:g id="arg0">%1$d</code:g> #bridge</item>
    <item quantity="other">%1$d / <code:g id="arg0">%1$d</code:g> ##bridges</item>
  </plurals>
  <plurals name="conventional_examples">
    <item quantity="one"><code:g id="arg0">%1$d</code:g>/<code:g id="arg0" example="">%1$d</code:g> #east</item>
    <item quantity="other"><code:g id="arg0" example="">%1$d</code:g>/<code:g id="arg0">%1$d</code:g> ##east</item>
  </plurals>

  <plurals name="product_signals" product="default">
    <item quantity="one">%1$d default #signal</item>
    <item quantity="other">%1$d default ##signals</item>
  </plurals>
  <plurals name="product_signals" product="tablet">
    <item quantity="one">%1$d tablet #signal</item>
    <item quantity="other">%1$d tablet ##signals</item>
  </plurals>

  <string translatable="false" name="protected_private">Keep #protected</string>
</resources>
