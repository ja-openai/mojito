<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2"
    xmlns:lane="http://schemas.android.com/apk/res-auto">
  <!-- Uses resolve definitions owned by other original resource files. -->
  <string name="macro_signal">@macro/harbor_phrase</string>
  <string name="macro_styled">@macro/styled_phrase</string>
  <string name="macro_protected">@macro/protected_phrase</string>
  <string name="macro_qualified">@neutral.cross.harbor:macro/harbor_phrase</string>
  <string name="macro_private">@*macro/route_phrase</string>
  <string name="macro_scoped">@lane:macro/route_phrase</string>
  <string name="macro_chain">@macro/scoped_chain</string>
  <string-array name="macro_routes">
    <item>@macro/route_phrase</item>
    <item>@macro/harbor_phrase</item>
  </string-array>
  <plurals name="macro_lights">
    <item quantity="one">@macro/one_light</item>
    <item quantity="other">@macro/other_lights</item>
  </plurals>
  <string name="macro_product" product="default">@macro/harbor_phrase</string>
  <string name="macro_product" product="tablet">@macro/tablet_phrase</string>
</resources>
