<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="OverlayCompass">
        <attr name="overlay_signal" format="string | reference" />
        <attr name="overlay_route"><enum name="quiet" value="0" /><enum name="bright" value="2" /></attr>
        <attr name="overlay_direction" format="flags"><flag name="east" value="1" /><flag name="west" value="2" /></attr>
    </declare-styleable>
    <string-array name="overlay_styleable_routes">
        <item>?attr/overlay_signal</item>
        <item>?attr/overlay_route</item>
        <item>?attr/overlay_direction</item>
        <item>A higher-priority styleable passage</item>
    </string-array>
</resources>
