        "encoding": "UTF-8",
        "source": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<resources xmlns:signal=\"urn:oasis:names:tc:xliff:document:1.2\">\n  <!-- Definitions are build-only and never editable translation slots. -->\n  <macro name=\"harbor_phrase\">A lower harbor</macro>\n  <macro name=\"styled_phrase\">Lower <b tone=\"bright\">harbor</b></macro>\n  <macro name=\"protected_phrase\">Lower <signal:g id=\"pilot\" example=\"L-0\">%1$s</signal:g></macro>\n  <macro name=\"route_phrase\">A remote channel</macro>\n  <macro name=\"one_light\">%1$d remote lantern</macro>\n  <macro name=\"other_lights\">%1$d remote lanterns</macro>\n  <macro name=\"tablet_phrase\">A remote tablet crossing</macro>\n</resources>\n",
        "androidResourcePath": "src/library/res/values/definitions.xml",
        "slots": []
      }
    },
