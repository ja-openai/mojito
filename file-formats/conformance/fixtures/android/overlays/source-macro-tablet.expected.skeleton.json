        "source": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<resources xmlns:xliff=\"urn:oasis:names:tc:xliff:document:1.2\"\n    xmlns:lane=\"http://schemas.android.com/apk/res-auto\">\n  <!-- Uses resolve definitions owned by other original resource files. -->\n  <string name=\"macro_signal\">@macro/harbor_phrase</string>\n  <string name=\"macro_styled\">@macro/styled_phrase</string>\n  <string name=\"macro_protected\">@macro/protected_phrase</string>\n  <string name=\"macro_qualified\">@neutral.cross.harbor:macro/harbor_phrase</string>\n  <string name=\"macro_private\">@*macro/route_phrase</string>\n  <string name=\"macro_scoped\">@lane:macro/route_phrase</string>\n  <string name=\"macro_chain\">@macro/scoped_chain</string>\n  <string-array name=\"macro_routes\">\n    <item>@macro/route_phrase</item>\n    <item>@macro/harbor_phrase</item>\n  </string-array>\n  <plurals name=\"macro_lights\">\n    <item quantity=\"one\">@macro/one_light</item>\n    <item quantity=\"other\">@macro/other_lights</item>\n  </plurals>\n  <string name=\"macro_product\" product=\"default\">@macro/harbor_phrase</string>\n  <string name=\"macro_product\" product=\"tablet\">@macro/tablet_phrase</string>\n</resources>\n",
