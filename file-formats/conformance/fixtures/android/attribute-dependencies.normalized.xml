<?xml version="1.0" encoding="utf-8"?>
<resources>
  <bag type="attr" name="direction" format="flags">
    <flag name="east" value="1" />
    <flag name="west" value="2" />
  </bag>
  <attr name="distance" format="integer" min="-2" max="31" />
  <attr name="open_water" />
  <attr name="passage" format="enum">
    <enum name="bright" value="2" />
    <enum name="quiet" value="0" />
  </attr>
  <attr name="signal" format="reference|string" />
  <string-array name="harbor_routes">
    <item>?attr/signal</item>
    <item>?attr/passage</item>
    <item>?attr/direction</item>
    <item>?attr/distance</item>
    <item>?open_water</item>
    <item>"A charted passage"</item>
    <item>"Another charted passage"</item>
  </string-array>
  <plurals name="harbor_signals">
    <item quantity="one">?attr/distance</item>
    <item quantity="other">"%d visible signals"</item>
  </plurals>
</resources>
