{
  "name": "reference-number-cardinal-selection",
  "source": ".input {$value :number}\n.match $value\nzero {{zero}}\none {{one}}\ntwo {{two}}\nfew {{few}}\nmany {{many}}\nother {{other}}\n* {{other}}",
