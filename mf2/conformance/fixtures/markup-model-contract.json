[
  {
    "name": "unpaired opening markers retain their order",
    "source": "{#style weight=bold}Hello {#color value=blue}world",
    "target": "{#style weight=|bold|}Bonjour {#color value=|blue|}monde",
    "locale": "fr",
    "valid": true
  },
  {
    "name": "unpaired opening markers cannot change order",
