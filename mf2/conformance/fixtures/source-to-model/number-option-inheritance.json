{
  "name": "number-option-inheritance",
  "source": ".input {$value :number minimumFractionDigits=1 signDisplay=always}\n.local $copy = {$value :number}\n.local $decimal = {1 :number minimumFractionDigits=2 minimumSignificantDigits=3}\n.local $integer = {$decimal :integer}\n.local $integerCopy = {$integer :number}\n.local $percent = {1 :percent minimumFractionDigits=2}\n.local $percentCopy = {$percent :number}\n.match $copy\none {{one {$copy}; integer {$integerCopy}; percent {$percentCopy}}}\nother {{other {$copy}; integer {$integerCopy}; percent {$percentCopy}}}\n* {{fallback {$copy}; integer {$integerCopy}; percent {$percentCopy}}}",
