    "declarations": [
      {
        "type": "input",
        "name": "foo",
        "value": {
          "type": "expression",
          "arg": { "type": "variable", "name": "foo" },
          "function": { "type": "function", "name": "number" }
        }
      }
    ],
    "pattern": [
      "bar ",
      { "type": "expression", "arg": { "type": "variable", "name": "foo" } }
