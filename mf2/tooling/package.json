{
  "name": "@mojito-mf2/tooling",
  "version": "0.1.0",
  "description": "Message contracts, translation checks and typed catalogs for Mojito MF2.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "files": [
    "src",
    "README.md",
